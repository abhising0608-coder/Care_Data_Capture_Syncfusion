/**
 * Core Philosophy:
 * This ruleset is designed for a rating note application.
 * It prioritizes securing user-specific and company-specific data.
 *
 * Data Structure:
 * - /ratingNotes/{noteId}: Each document contains the core data for a rating note.
 * - /companies/{companyId}: Master list of companies.
 * - /users/{userId}: User profiles and roles.
 * - /templates/{templateId}: Master list of note templates.
 * - /criteria/{criteriaId}: Master list of rating criteria.
 *
 * Key Security Decisions:
 * - Rating Notes: Only authenticated users can create rating notes. Access to read,
 *   update, or delete a note would typically be restricted to specific roles
 *   (e.g., the analyst who created it, their group head, or a QC member).
 *   (NOTE: Specific get/update/delete rules for notes are not yet implemented
 *   and should be added as the feature evolves).
 * - Master Data: All master data collections (companies, templates, criteria) are
 *   readable by any authenticated user, as this information is generally not
*   sensitive and is required for creating and viewing notes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for clarity and reusability
    
    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }
    
    /**
     * Validates that the user creating a new document is setting themselves
     * as the creator. This is a critical check for establishing ownership.
     */
    function hasValidCreationData() {
      return request.resource.data.createdBy == request.auth.uid;
    }

    // Allow authenticated users to read from master data collections
    match /companies/{companyId} {
      allow read: if isSignedIn();
    }
    match /templates/{templateId} {
      allow read: if isSignedIn();
    }
    match /criteria/{criteriaId} {
      allow read: if isSignedIn();
    }

    // Allow authenticated users to create new rating notes
    match /ratingNotes/{noteId} {
      allow create: if isSignedIn() && hasValidCreationData();
      // Add other rules (get, update, delete) as needed for the feature
    }
  }
}

/**
 * Core Philosophy: This ruleset implements a Role-Based Access Control (RBAC) model tailored for a financial ratings platform. 
 * The primary actors are 'CKC Analysts' and 'CKC Admins'. 
 * - CKC Analysts have ownership-based access, meaning they can read and update operational requests specifically assigned to them.
 * - CKC Admins have global, read-only access to all operational requests, providing oversight without modification rights.
 *
 * Data Structure:
 * - /ckc_operational_requests/{requestId}: The core collection storing all operational requests. Each document is a self-contained unit of work.
 * - /roles_admin/{uid}: An auxiliary collection used to grant admin privileges. The existence of a document with a user's UID as its ID signifies they are an admin.
 *
 * Key Security Decisions:
 * - Denormalization for Authorization: Each `ckc_operational_requests` document contains a denormalized `assignedTo` field (the analyst's UID). This is critical for writing performant and secure rules that do not require slow, costly `get()` calls to other documents to verify ownership.
 * - Admin Role Management: The `roles_admin` collection is read-only from the client. Granting or revoking admin rights must be handled by a trusted backend process (e.g., a Cloud Function with Admin SDK access), preventing unauthorized privilege escalation.
 * - Secure Querying: The `list` rule for operational requests is intentionally permissive for any signed-in user (`if isSignedIn()`). This is a deliberate choice to enable client-side queries (e.g., `where('assignedTo', '==', currentUser.uid)`). However, security is maintained because the more restrictive `get` rule still individually protects each document, ensuring that even if a user attempts a broad query, they can only actually read the data from documents they are authorized to access.
 * - Immutability: Critical relational fields like `createdBy` and `requestId` are enforced as immutable after creation to maintain data integrity.
 * - Default Deny on Deletion: To prevent accidental or malicious data loss, all `delete` operations on operational requests are disabled by default.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for reusable logic
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the requesting user has an admin role document.
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Checks if the requesting user's UID matches the provided userId.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Validates that the document exists and the user is the owner.
    // Used for state-changing operations like update and delete.
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * @description Rules for the collection storing operational data requests.
     * @path /ckc_operational_requests/{requestId}
     * @allow (get) A CKC Analyst gets a request assigned to them (`resource.data.assignedTo == request.auth.uid`).
     * @allow (get) A CKC Admin gets any request.
     * @allow (list) Any signed-in user lists requests, to enable client-side queries like `where('assignedTo', '==', uid)`. Individual document reads are still protected by the 'get' rule.
     * @allow (create) An authenticated user creates a new request, correctly setting their own UID in the `createdBy` field.
     * @allow (update) The assigned analyst updates an existing request.
     * @deny (get) A CKC Analyst attempts to get a request assigned to another analyst.
     * @deny (update) A CKC Admin attempts to update a request.
     * @deny (delete) Any user attempts to delete a request.
     * @principle Enforces a dual-access model: ownership for Analysts and global read-only for Admins. Uses denormalized 'assignedTo' field for performant authorization.
     */
    match /ckc_operational_requests/{requestId} {
      allow get: if (isOwner(resource.data.assignedTo) || isAdmin()) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isExistingOwner(resource.data.assignedTo) && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.requestId == resource.data.requestId;
      allow delete: if false;
    }

    /**
     * @description Rules for the admin roles collection. Document ID is the user's UID.
     * @path /roles_admin/{uid}
     * @allow (get) An admin checks if another user is an admin.
     * @deny (list) Any user attempts to list all admins to prevent user enumeration.
     * @deny (create, update, delete) Any client attempts to modify admin roles. This must be done via a secure backend.
     * @principle Restricts role management to server-side logic, preventing clients from escalating their own privileges.
     */
    match /roles_admin/{uid} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the operational input data collection.
     * @path /operational_input/{entryId}
     * @allow (get, create, update) An authenticated user can manage their own data entry documents.
     * @deny (delete) Deletion is not allowed.
     */
    match /operational_input/{entryId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isOwner(request.resource.data.createdBy);
      allow update: if isSignedIn() && isOwner(resource.data.createdBy);
      allow delete: if false;
    }
  }
}
